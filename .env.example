# ========================================================
# Rajalakshmy Associates CRM - Environment Template
# Copy this file to .env and fill in your values
# ========================================================

# Application Details
VITE_APP_NAME="Rajalakshmy Associates CRM"
VITE_APP_VERSION="1.0.0"

# GitHub Auto-Update Configuration (DO NOT commit your real token to Git)
GH_TOKEN=ghp_your_actual_github_token_here

# GitHub Repository Details
VITE_GITHUB_OWNER="sivaathri"
VITE_GITHUB_REPO="Rajalakshmy-Associates-CRM"

# Base URL / API Configuration
VITE_BASE_URL="http://localhost:5173"
VITE_API_BASE_URL="http://localhost:5000/api"
